{% assign certificates = data[1] %}

<!-- Entries without a date (e.g. the full archive link) act as a lead-in. -->
{% for content in certificates %}
  {% unless content.date %}
    <p class="cert-archive">
      {% if content.icon %}
        <i class="{{ content.icon }}"></i>
      {% endif %}
      <a href="{{ content.url | default: '#' }}" target="_blank" rel="noopener noreferrer">{{ content.name }}</a>
    </p>
  {% endunless %}
{% endfor %}

<div class="cert-timeline">
  {% assign dated = certificates | where_exp: 'c', 'c.date' | sort: 'date' | reverse %}
  {% assign current_year = '' %}
  {% for content in dated %}
    {% assign year = content.date | slice: 0, 4 %}
    {% if year != current_year %}
      {% assign current_year = year %}
      <div class="cert-year">
        <span class="cert-year-label">{{ year }}</span>
      </div>
    {% endif %}

    <div class="cert-item">
      <div class="cert-name">
        {% if content.url %}
          <a href="{{ content.url | relative_url }}" target="_blank" rel="noopener noreferrer">{{ content.name }}</a>
        {% else %}
          {{ content.name }}
        {% endif %}
        {% if content.note %}
          <span class="cert-note">({{ content.note }})</span>
        {% endif %}
      </div>
      <div class="cert-issuer">{{ content.issuer }}</div>

      {% if content.courses %}
        <ul class="cert-courses">
          {% for course in content.courses %}
            <li>
              {% if course.url %}
                <a href="{{ course.url | relative_url }}" target="_blank" rel="noopener noreferrer">{{ course.name }}</a>
              {% else %}
                {{ course.name }}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endfor %}
</div>
